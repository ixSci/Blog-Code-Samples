{
  "version": 10,
  "include": [
    "LocalConfig.json"
  ],
  "configurePresets": [
    {
      "name": "common",
      "description": "Common preset to inherit by other presets.",
      "inherits": "local-config",
      "hidden": true,
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "vs",
      "generator": "Visual Studio 18 2026",
      "inherits": "common",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "nj",
      "generator": "Ninja Multi-Config",
      "inherits": "common"
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "nj-debug",
      "configurePreset": "nj",
      "configuration": "Debug"
    },
    {
      "name": "nj-release",
      "configurePreset": "nj",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "nj-debug",
      "configurePreset": "nj",
      "configuration": "Debug"
    },
    {
      "name": "nj-release",
      "configurePreset": "nj",
      "configuration": "Release"
    }
  ]
}
