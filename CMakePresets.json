{
  "version": 8,
  "configurePresets": [
    {
      "name": "common",
      "description": "Common preset to inherit by other presets.",
      "hidden": true,
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "ENABLE_PCH": true,
        "REUSE_PCH": true,
        "CMAKE_UNITY_BUILD": true
      }
    },
    {
      "name": "vs",
      "generator": "Visual Studio 17 2022",
      "inherits": "common",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "nj",
      "generator": "Ninja Multi-Config",
      "inherits": "common"
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "nj-debug",
      "configurePreset": "nj",
      "configuration": "Debug"
    },
    {
      "name": "nj-release",
      "configurePreset": "nj",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "nj-debug",
      "configurePreset": "nj",
      "configuration": "Debug"
    },
    {
      "name": "nj-release",
      "configurePreset": "nj",
      "configuration": "Release"
    }
  ]
}
