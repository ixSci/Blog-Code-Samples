function(set_precompiled_headers PCH_NAME)
    if(ENABLE_PCH)
        if(REUSE_PCH)
            target_precompile_headers("${PROJECT_NAME}" REUSE_FROM "PCH.${PCH_NAME}")
        else()
            target_precompile_headers("${PROJECT_NAME}" PRIVATE "${CMAKE_SOURCE_DIR}/Instruments/PCH/${PCH_NAME}.h")
        endif()
    endif()
endfunction()
